{"n":"M203","c":"ModuleScript","s":"--[[\n\tM203\n\tA grenade launcher. The round is a physical projectile: it leaves slowly,\n\tarcs under gravity and explodes on the first thing it touches.\n\n\tFor a bouncing, timed grenade instead, set:\n\t\tExplosive = { DetonateOnImpact = false, Fuse = 3 }\n\t\tBounce = { Count = 4 }\n]]\n\nreturn {\n\tName = \"M203\",\n\tDescription = \"40mm grenade launcher. Rounds arc and explode on impact.\",\n\n\tFire = {\n\t\tModes = { \"Semi\" },\n\t\tRPM = 60,\n\t},\n\n\tAmmo = {\n\t\tMagazine = 1,\n\t\tReserve = 8,\n\t\tReloadTime = 2.6,\n\t},\n\n\tBallistics = {\n\t\tType = \"Projectile\",\n\t\tVelocity = 190,\n\t\tGravity = 1,\n\t\tDrag = 0.05,\n\t\tLifetime = 10,\n\t\tRange = 2500,\n\t\tExplosive = {\n\t\t\tEnabled = true,\n\t\t\tDamage = 140,\n\t\t\tRadius = 20,\n\t\t\tFalloff = \"Linear\",\n\t\t\tDetonateOnImpact = true,\n\t\t\tSelfDamageScale = 0.6,\n\t\t\tKnockback = 70,\n\t\t},\n\t},\n\n\tDamage = {\n\t\tBase = 60,\n\t},\n\n\tSpread = {\n\t\tHip = 1.2,\n\t\tAim = 0.4,\n\t\tPerShot = 0,\n\t},\n\n\tRecoil = {\n\t\tVertical = 2.6,\n\t\tHorizontal = 0.4,\n\t\tRecovery = 0.8,\n\t},\n\n\tEffects = {\n\t\t-- A launcher goes thump, not bang: a low, slowed explosion.\n\t\tSounds = { Fire = \"rbxasset://sounds/impact_explosion_03.mp3\", FirePitch = 1.6, FireVolume = 0.6 },\n\t\tTracer = { Enabled = false },\n\t},\n}\n","k":[{"n":"Model","c":"Model","k":[{"n":"Handle","c":"Part","p":{"CanCollide":false,"Size":[0.2,0.2,0.2],"Transparency":1},"k":[{"n":"MainHandle","c":"Attachment"},{"n":"Barrel","c":"Attachment","p":{"CFrame":[0,0.3,-2.89,1,0,0,0,1,0,0,0,1]}},{"n":"Grip","c":"Attachment","p":{"CFrame":[0,0.11,-1.97,1,0,0,0,1,0,0,0,1]}},{"n":"Mag","c":"Attachment","p":{"CFrame":[0,0.3,-1.72,1,0,0,0,1,0,0,0,1]}},{"n":"Aim","c":"Attachment","p":{"CFrame":[0,1.11,-0.37,1,0,0,0,1,0,0,0,1]}}]},{"n":"Part1","c":"Part","p":{"CFrame":[0.007,0.666,-0.46,0,0,-1,0,1,0,1,0,0],"Color":[0.431,0.431,0.439],"Material":"Metal","Size":[0.975,0.15,0.15]},"k"