{"n":"Panzerfaust3","c":"ModuleScript","s":"--[[\n\tPanzerfaust 3\n\tA rocket launcher. One rocket that flies, drops a little and explodes on\n\twhatever it hits.\n]]\n\nreturn {\n\tName = \"Panzerfaust 3\",\n\tDescription = \"Shoulder-fired anti-tank rocket launcher.\",\n\tScale = 0.62,\n\n\tFire = { Modes = { \"Semi\" }, RPM = 30 },\n\tAmmo = { Magazine = 1, Reserve = 4, ReloadTime = 4.5 },\n\tBallistics = {\n\t\tType = \"Projectile\",\n\t\tVelocity = 160,\n\t\tGravity = 0.3,\n\t\tDrag = 0.02,\n\t\tLifetime = 8,\n\t\tExplosive = {\n\t\t\tEnabled = true,\n\t\t\tDamage = 200,\n\t\t\tRadius = 22,\n\t\t\tDetonateOnImpact = true,\n\t\t\tSelfDamageScale = 0.6,\n\t\t\tKnockback = 90,\n\t\t},\n\t},\n\tDamage = { Base = 60 },\n\tSpread = { Hip = 2, Aim = 0.2, PerShot = 0 },\n\tRecoil = { Vertical = 4, Horizontal = 1 },\n\tHandling = { EquipTime = 1.0, AimTime = 0.35, WalkSpeedScale = 0.8, AimWalkSpeedScale = 0.5 },\n\n\tEffects = {\n\t\tProjectile = { Size = 0.5, Trail = true },\n\t\tSounds = { Fire = \"rbxasset://sounds/impact_explosion_03.mp3\", FirePitch = 1.2, FireVolume = 0.8 },\n\t},\n\n\tAttachments = {\n\t\tAllowed = { Optic = {}, Muzzle = {}, Underbarrel = {}, Side = {} },\n\t},\n}\n","k":[{"n":"Model","c":"Model","k":[{"n":"Handle","c":"Part","p":{"CanCollide":false,"Size":[0.2,0.2,0.2],"Transparency":1},"k":[{"n":"MainHandle","c":"Attachment"},{"n":"Barrel","c":"Attachment","p":{"CFrame":[0,1.16,-4.4,1,0,0,0,1,0,0,0,1]}},{"n":"Grip","c":"Attachment","p":{"CFrame":[0,-0.1,-1.5,1,0,0,0,1,0,0,0,1]}},{"n":"Mag","c":"Attachment","p":{"CFrame":[0,0.8,-2.4,1,0,0,0,1,0,0,0,1]}},{"n":"Aim","c":"Attachment","p":{"CFrame":[0,1.65,0.6,1,0,0,0,1,0,0,0,1]}}]},{"n":"Part1","c":"Part","p":{"CFrame":[0.041,0.998,1.399,0,0,-1,0,1,0,1,0,0],"Color":[0.353,0.349,0.357],"Material":"SmoothPlastic","Size":[7.157,1.537,1.286]},"k":[{"n":"Mesh","c":"SpecialMesh","p":{"MeshId":"rbxassetid://9172276668","MeshType":"FileMesh","Scale":[2.394306,2.394306,2.394306]}}]},{"n":"Part2","c":"Part",