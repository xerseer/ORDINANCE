{"n":"Remington700","c":"ModuleScript","s":"--[[\n\tRemington 700\n\tA bolt-action rifle with the realism options on: the chambered round is\n\ttracked separately from the magazine, and every shot needs the bolt cycled\n\tbefore the next.\n]]\n\nreturn {\n\tName = \"Remington 700\",\n\tDescription = \"Bolt-action .308 rifle. One shot, then work the bolt.\",\n\n\tFire = {\n\t\tModes = { \"Semi\" },\n\t\tRPM = 300,\n\t\tAction = \"Bolt\",\n\t\tCycleTime = 1.15,\n\t},\n\n\tAmmo = {\n\t\tMagazine = 5,\n\t\tReserve = 30,\n\t\tReloadTime = 3.2,\n\t},\n\n\tBallistics = {\n\t\tRange = 3000,\n\t\tPenetration = 1.5,\n\t},\n\n\tDamage = {\n\t\tBase = 85,\n\t\tMultipliers = { Head = 2.5, Torso = 1.1, Limb = 0.8 },\n\t\tFalloff = { Start = 600, End = 2000, MinScale = 0.75 },\n\t},\n\n\tSpread = {\n\t\tHip = 4.5,\n\t\tAim = 0.02,\n\t\tMoving = 2.5,\n\t\tPerShot = 0,\n\t},\n\n\tRecoil = {\n\t\tVertical = 3.2,\n\t\tHorizontal = 0.7,\n\t\tRecovery = 0.75,\n\t},\n\n\tHandling = {\n\t\tAimFOV = 22,\n\t\tAimTime = 0.3,\n\t\tAimWalkSpeedScale = 0.5,\n\t},\n\n\tRealism = {\n\t\tChambering = true,\n\t},\n\n\tEffects = {\n\t\tSounds = { Fire = \"rbxassetid://9118173739\", FireVolume = 0.9, RollOffMax = 1500 }, -- Rifle Single Shots 1 (Pro Sound Effects)\n\t},\n}\n","k":[{"n":"Model","c":"Model","k":[{"n":"Handle","c":"Part","p":{"CanCollide":false,"Size":[0.2,0.2,0.2],"Transparency":1},"k":[{"n":"MainHandle","c":"Attachment"},{"n":"Barrel","c":"Attachment","p":{"CFrame":[0,0.46,-4.935,1,0,0,0,1,0,0,0,1]}},{"n":"Grip","c":"Attachment","p":{"CFrame":[0,-0.02,-2.45,1,0,0,0,1,0,0,0,1]}},{"n":"Side","c":"Attachment","p":{"CFrame":[0.32,0.36,-0.81,1,0,0,0,1,0,0,0,1]}},{"n":"Mag","c":"Attachment","p":{"CFrame":[0,0.1,-0.81,1,0,0,0,1,0,0,0,1]}},{"n":"Aim","c":"Attachment","p":{"CFrame":[0,0.7,-0.55,1,0,0,0,1,0,0,0,1]}}]},{"n":"Barrel","c":"Part","p":{"CFrame":[-0.005,0.463,-2.937,1,0,0,0,1,0,0,0,1],"Color":[0.153,0.149,0.153],"Material":"Plastic","Size":[0.15,0.15,3.25]},"k":[{"n":"Mesh","c":"Spec