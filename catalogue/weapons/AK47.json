{"n":"AK47","c":"ModuleScript","s":"--[[\n\tAk-47\n\tA select-fire rifle. The fire mode key switches between automatic and\n\tsemi-automatic.\n\n\tThe model is from the MeshPart gun kit in Workspace.Models, stored here as\n\tParts with SpecialMeshes so Rojo can sync it. It was built about 1.6 times\n\tthe size of the other rifles, so Scale brings it down.\n]]\n\nreturn {\n\tName = \"Ak-47\",\n\tDescription = \"7.62mm assault rifle with automatic and semi-automatic fire.\",\n\tScale = 0.62,\n\n\tFire = {\n\t\tMode = \"Auto\",\n\t\tModes = { \"Auto\", \"Semi\" },\n\t\tRPM = 750,\n\t},\n\n\tAmmo = {\n\t\tMagazine = 37,\n\t\tReserve = 150,\n\t\tReloadTime = 2.3,\n\t\tReloadEmptyTime = 2.8,\n\t},\n\n\tBallistics = {\n\t\tPenetration = 0.6,\n\t},\n\n\tDamage = {\n\t\tBase = 38,\n\t\tFalloff = { Start = 150, End = 500 },\n\t},\n\n\tSpread = {\n\t\tHip = 2.6,\n\t\tAim = 0.3,\n\t\tPerShot = 0.3,\n\t},\n\n\tRecoil = {\n\t\tVertical = 0.75,\n\t\tHorizontal = 0.55,\n\t},\n}\n","k":[{"n":"Model","c":"Model","k":[{"n":"Handle","c":"Part","p":{"CanCollide":false,"Size":[0.2,0.2,0.2],"Transparency":1},"k":[{"n":"MainHandle","c":"Attachment"},{"n":"Barrel","c":"Attachment","p":{"CFrame":[0,0.965,-4.605,1,0,0,0,1,0,0,0,1]}},{"n":"Grip","c":"Attachment","p":{"CFrame":[0,0.574,-2.211,1,0,0,0,1,0,0,0,1]}},{"n":"Side","c":"Attachment","p":{"CFrame":[-0.254,0.839,-0.721,1,0,0,0,1,0,0,0,1]}},{"n":"Mag","c":"Attachment","p":{"CFrame":[0,0.04,-1.17,1,0,0,0,1,0,0,0,1]}},{"n":"Aim","c":"Attachment","p":{"CFrame":[0,1.333,-0.08,1,0,0,0,1,0,0,0,1]}}]},{"n":"Part1","c":"Part","p":{"CFrame":[0,0.584,-0.273,0,0,-1,0,1,0,1,0,0],"Color":[0.408,0.278,0.098],"Material":"SmoothPlastic","Size":[5.106,1.456,0.262]},"k":[{"n":"Mesh","c":"SpecialMesh","p":{"MeshId":"rbxassetid://7523735322","MeshType":"FileMesh","Scale":[0.701,0.701,0.701]}}]},{"n":"Part2","c":"Part","p":{"CFrame":[0,0.871,-1.736,0,0,-1,0,1,0,1,0,0],"Color":[0.22,0.22,0.224],"Material":"SmoothPlastic","Size":[5.335,0.97,0.254]},"k":[{"n":"M